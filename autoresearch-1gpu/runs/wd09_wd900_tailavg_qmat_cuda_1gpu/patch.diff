     return out
 
 
+def should_tail_average_tensor(t: Tensor, only_large_matrices: bool) -> bool:
+    if not t.is_floating_point():
+        return False
+    if only_large_matrices:
+        return t.ndim == 2 and t.numel() > INT8_KEEP_FLOAT_MAX_NUMEL
+    return t.ndim > 0
+
+
+def capture_tail_avg_state(model: nn.Module, only_large_matrices: bool) -> dict[str, Tensor]:
+    return {
+        name: tensor.detach().float().clone()
+        for name, tensor in model.state_dict().items()
+        if should_tail_average_tensor(tensor, only_large_matrices)
+    }
+
+
+@torch.no_grad()
+def update_tail_avg_state(avg_state: dict[str, Tensor], model: nn.Module, updates: int) -> None:
+    alpha = 1.0 / float(updates + 1)
+    for name, tensor in model.state_dict().items():
+        avg = avg_state.get(name)
+        if avg is None:
+            continue
+        avg.lerp_(tensor.detach().float(), alpha)
+
+
+@torch.no_grad()
+def apply_tail_avg_state(model: nn.Module, avg_state: dict[str, Tensor]) -> None:
+    merged_state: dict[str, Tensor] = {}
+    for name, tensor in model.state_dict().items():
+        avg = avg_state.get(name)
+        if avg is None:
+            merged_state[name] = tensor
+            continue
+        merged_state[name] = avg.to(device=tensor.device, dtype=tensor.dtype).contiguous()
+    model.load_state_dict(merged_state, strict=True)
+
+
